{
  "name": "@ahmedgeindy/jira-worklog",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Agent skill for logging time to Jira through the twg CLI, with a human gate and guarded writes",
  "type": "module",
  "bin": {
    "jira-worklog": "scripts/setup.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test \"scripts/test/*.test.mjs\" \"tools/*.test.mjs\"",
    "audit": "node tools/audit-package.mjs",
    "audit:public": "node tools/audit-package.mjs --public",
    "audit:selftest": "node tools/audit-package.mjs --self-test",
    "e2e": "node tools/e2e-setup.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "references",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedgeindy/jira-worklog-skill.git"
  },
  "homepage": "https://github.com/ahmedgeindy/jira-worklog-skill#readme",
  "bugs": {
    "url": "https://github.com/ahmedgeindy/jira-worklog-skill/issues"
  },
  "keywords": [
    "jira",
    "worklog",
    "timesheet",
    "time-tracking",
    "agent-skill",
    "claude-code",
    "codex",
    "twg",
    "atlassian"
  ]
}
